# Local embedding retrieval
EMBEDDING_PROVIDER=transformers_local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Put the downloaded model outside the repo if possible.
EMBEDDING_MODEL_PATH=/Users/your-user/.cache/torch/sentence_transformers/Qwen_Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_DIM=1024
EMBEDDING_QUERY_TASK="Given a web search query, retrieve relevant passages that answer the query"

# Optional TEI settings when EMBEDDING_PROVIDER=tei_local
EMBEDDING_ENDPOINT=http://127.0.0.1:8080
EMBEDDING_TIMEOUT_SECONDS=30

# Retrieval / context pack
CHUNK_TARGET_CHARS=1000
CHUNK_MAX_CHARS=1400
CHUNK_OVERLAP_CHARS=150
MIN_CHUNK_CHARS=80
LEXICAL_TOP_K=20
SEMANTIC_TOP_K=20
RRF_K=60
ANSWER_CONTEXT_LIMIT=6000
ANSWER_CHUNK_CHAR_LIMIT=1200

# Local answer generation
ANSWER_LLM_PROVIDER=ollama
ANSWER_LLM_MODEL=qwen2.5:3b
ANSWER_LLM_API_BASE=http://127.0.0.1:11434
ANSWER_LLM_TEMPERATURE=0.1
ANSWER_LLM_MAX_OUTPUT_TOKENS=600
ANSWER_LLM_TIMEOUT_SECONDS=120
ANSWER_CITATION_RETRY_LIMIT=1
ANSWER_CITATION_FALLBACK_MAX_SENTENCES=3

# Optional OpenAI-compatible endpoint settings
# ANSWER_LLM_PROVIDER=openai_compatible
# ANSWER_LLM_MODEL=your-model
# ANSWER_LLM_API_BASE=https://your-endpoint.example.com/v1
# ANSWER_LLM_API_KEY=your-api-key
